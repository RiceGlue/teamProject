    <update id="updateWaitingStatus" parameterType="map">
        UPDATE waitings 
        SET status = #{status}, updated_at = NOW() 
        WHERE waiting_id = #{waitingId}
    </update>

    <delete id="deleteWaiting" parameterType="long">
        DELETE FROM waiting WHERE waiting_id = #{waitingId}
    </delete>

</mapper>
