<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.teamProject.dao.WaitingDAO">
    <resultMap id="WaitingResultMap" type="com.spring.teamProject.vo.WaitingVO">
        <id property="waitingId" column="waiting_id"/>
        <result property="memberId" column="member_id"/>
        <result property="storeId" column="store_id"/>
        <result property="guestCount" column="guest_count"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="getAllWaitings" resultMap="WaitingResultMap">
        SELECT * FROM waiting
    </select>

    <select id="getWaitingById" parameterType="long" resultMap="WaitingResultMap">
        SELECT * FROM waiting WHERE waiting_id = #{waitingId}
    </select>

    <insert id="insertWaiting" parameterType="com.spring.teamProject.vo.WaitingVO">
        INSERT INTO waiting (member_id, store_id, guest_count, status, created_at, updated_at)
        VALUES (#{memberId}, #{storeId}, #{guestCount}, #{status}, NOW(), NOW())
    </insert>

    <update id="updateWaitingStatus">
        UPDATE waiting SET status = #{status}, updated_at = NOW() WHERE waiting_id = #{waitingId}
    </update>

    <delete id="deleteWaiting" parameterType="long">
        DELETE FROM waiting WHERE waiting_id = #{waitingId}
    </delete>
</mapper>

