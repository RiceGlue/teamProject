<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.teamProject.dao.PaymentDAO">

	<resultMap id="paymentResultMap" type="com.spring.teamProject.vo.PaymentVO">
		<id property="paymentId" column="payment_id"/>
		<result property="reservationId" column="reservation_id"/>
		<result property="amount" column="amount"/>
		<result property="paymentMethod" column="payment_method"/>
		<result property="status" column="status"/>
		<result property="transactionId" column="transaction_id"/>
		<result property="paidAt" column="paid_at"/>
		<result property="createdAt" column="created_at"/>
	</resultMap>

    <insert id="insertPayment" parameterType="com.spring.teamProject.vo.PaymentVO"
            useGeneratedKeys="true" keyProperty="paymentId">
        INSERT INTO payments (
            reservation_id, amount, payment_method, status, transaction_id
        ) VALUES (
            #{reservationId}, #{amount}, #{paymentMethod}, #{status}, #{transactionId}
        )
    </insert>

	<select id="selectByTransactionId" resultType="com.spring.teamProject.vo.PaymentVO">
        SELECT
            paymentId,
            reservationId,
            amount,
            paymentMethod,
            transactionId,
            status,
            paidAt,
            createdAt
        FROM payments
        WHERE transactionId = #{transactionId}
    </select>

<!--     <select id="selectByTransactionId" parameterType="String" resultMap="paymentResultMap"> -->
<!--         SELECT -->
<!--             payment_id, reservation_id, amount, payment_method, status, transaction_id, paid_at, created_at -->
<!--         FROM -->
<!--             payments -->
<!--         WHERE transaction_id = #{transactionId} -->
<!--     </select> -->

    <update id="updatePaymentStatus" parameterType="com.spring.teamProject.vo.PaymentVO">
        UPDATE payments
        SET
            status = #{status},
            paid_at = #{paidAt}  WHERE
            payment_id = #{paymentId}
    </update>

    <select id="selectByReservationId" resultType="com.spring.teamProject.vo.PaymentVO">
        SELECT
            paymentId,
            reservationId,
            amount,
            paymentMethod,
            transactionId,
            status,
            paidAt,
            createdAt
        FROM payments
        WHERE reservationId = #{reservationId}
        LIMIT 1 -- 예약 1개당 결제 정보는 1개여야 하므로 LIMIT 1
    </select>
</mapper>