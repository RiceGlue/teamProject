<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="com.spring.teamProject.dao.AdminStoreDAO">
	<resultMap id="storelist" type="StoreVO">
		<result property="storeId" column="store_id"/>
		<result property="ownerId" column="owner_id"/>
		<result property="storeName" column="store_Name"/>
		<result property="address" column="address"/>
		<result property="region" column="region"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
		<result property="avgRating" column="avgRating"/>
		<result property="countRating" column="countRating"/>
	</resultMap>
	
	<resultMap id="storeInfo" type="StoreVO">
		<result property="storeId" column="store_id" />
		<result property="storeName" column="store_name" />
		<result property="storeType" column="store_type" />
		<result property="operationType" column="operation_type" />
		<result property="storePhoneNumber" column="store_phone_number" />
		<result property="address" column="address" />
		<result property="breakTime" column="break_time" />
		<result property="description" column="description" />
		<result property="amenities" column="amenities" />
		<result property="fileName" column="file_name" />
		<result property="closed" column="closed" />
		<result property="operatingHours" column="operating_hours" />
		<result property="lastOrder" column="last_order" />
		<result property="avgRating" column="avgRating"/>
		<result property="countRating" column="countRating"/>
	</resultMap>
	
	
	<resultMap id="imagelist" type="ImageFileVO">
		<result property="imageId" column="image_id"/>
		<result property="storeId" column="store_id"/>
		<result property="reviewId" column="review_id"/>
		<result property="fileName" column="file_name"/>
		<result property="fileType" column="file_type"/>
		<result property="displayNo" column="display_no"/>
		<result property="createdAt" column="created_at"/>
		<result property="regId" column="reg_id"/>
	</resultMap>
	
	<resultMap type="MenuVO" id="menulist">
		<result property="menuId" column="menu_id" />
		<result property="storeId" column="store_id" />
		<result property="displayNo" column="display_no" />
		<result property="menuName" column="menu_name" />
		<result property="price" column="price" />
		<result property="description" column="description" />
		<result property="fileName" column="file_name" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
	</resultMap>
	
	<resultMap id="reservationlist" type="ReservationSettingVO">
		<result property="settingId" column="setting_id" />
		<result property="storeId" column="store_id"/>
		<result property="dayOfWeek" column="day_of_week"/>
		<result property="timeSlot" column="time_slot"/>
		<result property="isActive" column="is_active"/>
	</resultMap>
	
	<resultMap id="reviewlist" type="ReviewVO">
		<result property="reviewId" column="review_id" />
		<result property="memberId" column="member_id" />
		<result property="writerId" column="writerId" />
		<result property="storeId" column="store_id" />
		<result property="reservationId" column="reservation_id" />
		<result property="waitingId" column="waiting_id" />
		<result property="rating" column="rating" />
		<result property="content" column="content" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
		<result property="avgRating" column="avgRating" />
		<result property="countRating" column="countRating" />
		<result property="countScoreRating" column="countScoreRating" />
	</resultMap>
	
	<select id="selectStoreId" parameterType="storeVO" resultType="long">
		<![CDATA[
			select store_id from stores where owner_id = #{ownerId} and store_name=#{storeName}
		]]>
	</select>
	
	<select id="selectStoreInfo" resultMap="storelist" parameterType="String">
		<![CDATA[
			select * from stores where storeId = #{storeId}
		]]>
	</select>
	
	<insert id="insertStoreInfo" parameterType="map" >
	    insert into stores (store_id, store_name, store_type, operation_type, store_phone_number, break_time, description, amenities, file_name, created_at, update_at, operating_hours, closed, last_order ) values
	        (
	            #{store.storeId},
	            #{store.storeName},
	            #{store.storeType},
	            #{store.operationType},
	            #{store.storePhoneNumber},
	            #{store.breakTime},
	            #{store.description},
	            #{store.amenities},
	            #{store.fileName},
	            now(),
	            now(),
	            #{store.operatingHours},
	            #{store.closed},
	            #{store.lastOrder}
	        )
	    <selectKey>
	        select LAST_INSERT_ID()
	    </selectKey>
	</insert>

	
</mapper>