<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.teamProject.dao.StoreTableDAO">

	<resultMap id="storeTableResultMap" type="com.spring.teamProject.vo.StoreTableVO">
		<id property="tableId" column="table_id"/>
		<result property="storeId" column="store_id"/>
		<result property="tableName" column="table_info"/>
		<result property="capacity" column="capacity"/>
		<result property="posX" column="pos_x"/>
		<result property="posY" column="pos_y"/>
	</resultMap>

    <select id="selectAllTablesByStoreId" resultMap="storeTableResultMap">
        SELECT
            table_id, store_id, table_info, capacity, pos_x, pos_y
        FROM
            store_tables
        WHERE
            store_id = #{storeId}
        ORDER BY
            capacity, table_info
    </select>

    <select id="selectStoreTableById" parameterType="java.lang.Long" resultMap="storeTableResultMap">
    	SELECT
    		table_id, store_id, table_info, capacity, pos_x, pos_y
    	FROM
    		store_tables
    	WHERE
    		table_id = #{tableId}
    </select>

</mapper>
