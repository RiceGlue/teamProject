<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="mapper.menu">
	<resultMap id="menulist" type="MenuVO">
		<result property="menuId" column="menuId"/>
		<result property="storeId" column="storeId"/>
		<result property="displayNo" column="displayNo"/>
		<result property="menuName" column="menuName"/>
		<result property="price" column="price"/>
		<result property="description" column="description"/>
		<result property="imageUrl" column="imageUrl"/>
		<result property="createdAt" column="createdAt"/>
		<result property="updatedAt" column="updatedAt"/>
	</resultMap>
	
	<insert id="addMenuInfo" parameterType="map" >
		<![CDATA[ 
			insert into menu (store_id, display_no, menu_name, price, description, image_url, created_at, updated_at) values
			<<foreach collection="menulist" item="menu" separator=",">
				(
					#{storeId},
					#{displayNo},
					#{menuName},
					#{price},
					#{description},
					#{imageUrl},
					NOW(),
					NOW()
					
				)
			</foreach>
		]]>
	</insert>
	
</mapper>