<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="com.spring.teamProject.dao.ReviewDAO">
	<resultMap id="reservationInfo" type="ReservationVO">
	    <result property="reservationId" column="reservation_id" />
	    <result property="memberId" column="member_id"/>
	    <result property="storeId" column="store_id"/>
	    <result property="reservationTime" column="reservation_time"/>
	    <result property="guestCount" column="guest_count"/>
	    <result property="status" column="status"/>
	    <result property="createdAt" column="created_at"/>
	    <result property="cancelledReason" column="cancelled_reason"/>
	</resultMap>
	
	<resultMap id="waitingInfo" type="WaitingVO">
	    <result property="waitingId" column="waiting_id" />
	    <result property="memberId" column="member_id"/>
	    <result property="storeId" column="store_id"/>
	    <result property="guestCount" column="guest_count"/>
	    <result property="status" column="status"/>
	    <result property="createdAt" column="created_at"/>
	    <result property="updatedAt" column="updated_at" />
	</resultMap>
	
	<resultMap id="reviewlist" type="ReviewVO">
		<result property="reviewId" column="review_id" />
		<result property="memberId" column="member_id" />
		<result property="writerId" column="writerId" />
		<result property="storeId" column="store_id" />
		<result property="storeName" column="store_name" />
		<result property="roadAddress" column="road_address"/>
		<result property="localNumber" column="local_number" />
		<result property="number1" column="number1" />
		<result property="number2" column="number2" />
		<result property="storeType" column="store_type" />
		<result property="reservationId" column="reservation_id" />
		<result property="waitingId" column="waiting_id" />
		<result property="rating" column="rating" />
		<result property="content" column="content" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
		<result property="avgRating" column="avgRating" />
		<result property="countRating" column="countRating" />
		<result property="countScoreRating" column="countScoreRating" />
		<result property="taste" column="taste" />
		<result property="mood" column="mood" />
		<result property="service" column="service" />
		<result property="clean" column="clean" />
		<result property="likes" column="likes" />
	</resultMap>
	
	<resultMap id="reviewlikeInfo" type="ReviewLikeVO">
		<result property="reviewId" column="review_id" />
		<result property="memberId" column="member_id" />
		<result property="liked" column="liked" />
	</resultMap>
	
	<resultMap id="storeInfo" type="StoreVO">
		<result property="storeId" column="store_id"/>
		<result property="ownerId" column="owner_id"/>
		<result property="storeName" column="store_Name"/>
		<result property="storeType" column="store_type" />
		<result property="postcode" column="postcode" />
		<result property="roadAddress" column="road_address"/>
		<result property="jibunAddress" column="jibun_address"/>
		<result property="detailAddress" column="detail_address"/>
		<result property="extraAddress" column="extra_address"/>
		<result property="operationType" column="operation_type" />
		<result property="localNumber" column="local_number" />
		<result property="number1" column="number1" />
		<result property="number2" column="number2" />
		<result property="description" column="description" />
		<result property="closed" column="closed" />
		<result property="operatingTime" column="operating_time" />
		<result property="breakTime" column="break_time" />
		<result property="lastOrder" column="last_order" />
		<result property="amenities" column="amenities" />
		<result property="fileName" column="file_name" />
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
		<result property="avgRating" column="avgRating"/>
		<result property="countRating" column="countRating"/>
	</resultMap>
	
	<resultMap id="imagelist" type="ImageFileVO">
		<result property="imageId" column="image_id"/>
		<result property="storeId" column="store_id"/>
		<result property="reviewId" column="review_id"/>
		<result property="fileName" column="file_name"/>
		<result property="fileType" column="file_type"/>
		<result property="displayNo" column="display_no"/>
		<result property="createdAt" column="created_at"/>
		<result property="regId" column="reg_id"/>
	</resultMap>
	
	<resultMap id="manageReview" type="ManageReviewVO">
		<result property="manageId" column="manage_id"/>
		<result property="reviewId" column="review_id"/>
		<result property="ownerId" column="owner_id"/>
		<result property="storeId" column="store_id"/>
		<result property="requestId" column="requestId"/>
		<result property="storeName" column="store_name"/>
		<result property="requestReason" column="request_reason"/>
		<result property="customReason" column="custom_reason"/>
		<result property="status" column="status"/>
		<result property="rejectedReason" column="rejected_reason" />
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>
	
	<select id="selectReview" parameterType="long" resultMap="reviewlist">
		<![CDATA[
			select * from reviews where review_id = #{reviewId}
		]]>
	</select>
	
	<select id="selectReservationById" parameterType="long" resultMap="reservationInfo">
	    <![CDATA[
	        select * from reservations where reservation_id=#{reservationId}
	    ]]>
	</select>
	
	<select id="selectWaitingById" parameterType="long" resultMap="waitingInfo">
	    <![CDATA[
	        select * from waitings where waiting_id=#{waitingId}
	    ]]>
	</select>
	
	<select id="selectStore" parameterType="long" resultMap="storeInfo">
		<![CDATA[
			SELECT store_id, store_name, file_name 
			FROM stores
			WHERE store_id=#{storeId}
		]]>
	</select>
	
	<insert id="insertReservationReview" parameterType="ReviewVO">
	    <selectKey keyProperty="reviewId" resultType="long" order="AFTER">
	        SELECT LAST_INSERT_ID()
	    </selectKey>
	    INSERT INTO reviews (
	        member_id, store_id, reservation_id,
	        rating, content, taste, mood, service, clean, created_at
	    ) VALUES (
	        #{memberId}, #{storeId}, #{reservationId},
	        #{rating}, #{content}, #{taste}, #{mood}, #{service}, #{clean}, NOW()
	    )
	</insert>
	
	<insert id="insertWaitingReview" parameterType="ReviewVO">
	    <selectKey keyProperty="reviewId" resultType="long" order="AFTER">
	        SELECT LAST_INSERT_ID()
	    </selectKey>
	    INSERT INTO reviews (
	        member_id, store_id, waiting_id,
	        rating, content, taste, mood, service, clean, created_at
	    ) VALUES (
	        #{memberId}, #{storeId}, #{waitingId},
	        #{rating}, #{content}, #{taste}, #{mood}, #{service}, #{clean}, NOW()
	    )
	</insert>

	<insert id="insertReviewImageFiles" parameterType="list">
	    insert into image_file (file_name, display_no, reg_id, store_id, review_id, created_at)
	    values
	    <foreach collection="list" item="item" separator=",">
	        (
	            #{item.fileName},
	            #{item.displayNo},
	            #{item.regId},
	            #{item.storeId},
	            #{item.reviewId},
	            now()
	        )
	    </foreach>
	</insert>
	
	<select id="selectReviewImageFile" parameterType="long" resultMap="imagelist">
		<![CDATA[
			select * from image_file where review_id = #{reviewId}
		]]>
	</select>
	
	<update id="updateReview" parameterType="ReviewVO" >
		<![CDATA[
			UPDATE reviews
			SET
		        rating = #{rating},
		        content = #{content},
		        taste = #{taste},
		        mood = #{mood},
		        service = #{service},
		        clean = #{clean},
		        updated_at = now()
		    WHERE review_id = #{reviewId}
		]]>
	</update>

	<select id="selectReviewImageById" parameterType="long" resultMap="imagelist" >
		<![CDATA[
			select * from image_file where image_id = #{imageId}
		]]>
	</select>
	
	<delete id="deleteReviewImage" parameterType="long" >
		<![CDATA[
			delete from image_file where image_id = #{imageId}
		]]>
	</delete>
	
	<insert id="insertReviewImage" parameterType="ImageFileVO" >
		<![CDATA[
			insert into image_file (file_name, display_no, reg_id, store_id, review_id, created_at)
			values
			(
				#{fileName},
				#{displayNo},
				#{regId},
				#{storeId},
				#{reviewId},
				now()	 
			)		
		]]>
	</insert>
	
	<delete id="deleteReviewImages" parameterType="long" >
		<![CDATA[
			delete from image_file where review_id =#{reviewId}
		]]>
	</delete>
	
	<delete id="deleteReview" parameterType="long" >
		<![CDATA[
			delete from reviews where review_id =#{reviewId}
		]]>
	</delete>
	
	<select id="selectBestReview" resultMap="reviewlist">
	  <![CDATA[
	    SELECT *
	    FROM (
	        SELECT 
	            s.store_id,
	            s.store_name,
	            s.road_address,
	            s.local_number,
	            s.number1,
	            s.number2,
	            s.store_type,
	            r.review_id,
	            r.member_id,
	            r.content,
	            r.created_at,
	            COUNT(rl.review_id) AS likes,
	            r.rating,
	            m.login_id AS writerId,
	            ROW_NUMBER() OVER (PARTITION BY s.store_id ORDER BY COUNT(rl.review_id) DESC) AS rn
	        FROM stores s
	        INNER JOIN reviews r ON s.store_id = r.store_id
	        INNER JOIN members m ON r.member_id = m.member_id
	        LEFT JOIN review_like rl ON r.review_id = rl.review_id
	        GROUP BY 
	            s.store_id, s.store_name, s.road_address, s.local_number, s.number1, s.number2, s.store_type,
	            r.review_id, r.member_id, r.content, r.created_at, r.rating, m.login_id
	    ) ranked
	    WHERE ranked.rn = 1
	    ORDER BY ranked.likes DESC
	    LIMIT 10;
	  ]]>
	</select>

	<select id="selectBestReviewImage" parameterType="long" resultMap="imagelist" >
		<![CDATA[
			select review_id, file_name, store_id from image_file where review_id=#{reviewId} and display_no=0
		]]>
	</select>
	
	<insert id="increaseLikes" parameterType="ReviewLikeVO">
    	<![CDATA[
    		insert into review_like value (#{reviewId}, #{memberId})
    	]]>
	</insert>
	
	<delete id="decreaseLikes" parameterType="ReviewLikeVO">
	    <![CDATA[
    		delete from review_like where member_id = #{memberId} and review_id = #{reviewId}
    	]]>
	</delete>
	
	<select id="getLikeCount" parameterType="long" resultType="int">
		<![CDATA[
	    	SELECT count(review_id) FROM review_like WHERE review_id = #{reviewId}
	    ]]>
	</select>
	
	<select id="isLiked" parameterType="ReviewLikeVO" resultType="boolean" >
		<![CDATA[
			SELECT EXISTS (
		        SELECT 1 FROM review_like
		        WHERE member_id = #{memberId}
		          AND review_id = #{reviewId}
		    ) as liked;
		]]>
	</select>
	
	<select id="uesrLikeReview" parameterType="long" resultMap="reviewlikeInfo" >
		<![CDATA[
			select * from review_like where member_id = #{memberId}
		]]>
	</select>
	
	<select id="selectUserReview" parameterType="long" resultMap="reviewlist" >
		<![CDATA[
			select * from reviews where member_id = #{memberId}
		]]>
	</select>
	
	<select id="selectStoreAllReview" parameterType="long" resultMap="reviewlist" >
		<![CDATA[
			select r.*, m.login_id as writerId from reviews r inner join members m on r.member_id = m.member_id where store_id=#{storeId}
		]]>
	</select>
	
	<select id="countStoreAllReview" parameterType="long" resultType="int" >
		<![CDATA[
			select count(review_id) as countRating from reviews where store_id=#{storeId}
		]]>
	</select>
	
	<insert id="requestReviewManage" parameterType="ManageReviewVO" >
		<![CDATA[
			insert into manage_review (review_id, owner_id, store_id, request_reason, custom_reason, created_at )
			values
			(
				#{reviewId},
				#{ownerId},
				#{storeId},
				#{requestReason},
				#{customReason},
				now()
			)
		]]>
	</insert>
	
	<select id="getReviewManageStatus" parameterType="long" resultMap="manageReview">
		<![CDATA[
			select * from manage_review where review_id=#{reviewId}
		]]>
	</select>
	
	<select id="selectReviewManage" resultMap="manageReview" >
		<![CDATA[
			select r.*, s.store_name from manage_review r inner join stores s on r.owner_id=s.owner_id
		]]>
	</select>
	
	<update id="updateReviewManage" parameterType="ManageReviewVO" >
		<![CDATA[
			UPDATE manage_review
			SET
				status = #{status},
		        rejected_reason = #{rejectedReason},
		        updated_at = now()
		    WHERE manage_id = #{manageId}
		]]>
	</update>
	
</mapper>