<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="com.spring.teamProject.dao.ReviewDAO">
	<resultMap id="reservationInfo" type="ReservationVO">
	    <result property="reservationId" column="reservation_id" />
	    <result property="memberId" column="member_id"/>
	    <result property="storeId" column="store_id"/>
	    <result property="reservationTime" column="reservation_time"/>
	    <result property="guestCount" column="guest_count"/>
	    <result property="status" column="status"/>
	    <result property="createdAt" column="created_at"/>
	    <result property="cancelledReason" column="cancelled_reason"/>
	</resultMap>
	
	<resultMap id="waitingInfo" type="WaitingVO">
	    <result property="waitingId" column="waiting_id" />
	    <result property="memberId" column="member_id"/>
	    <result property="storeId" column="store_id"/>
	    <result property="guestCount" column="guest_count"/>
	    <result property="status" column="status"/>
	    <result property="createdAt" column="created_at"/>
	    <result property="updatedAt" column="updated_at" />
	</resultMap>
	
	<resultMap id="reviewlist" type="ReviewVO">
		<result property="reviewId" column="review_id" />
		<result property="memberId" column="member_id" />
		<result property="writerId" column="writerId" />
		<result property="storeId" column="store_id" />
		<result property="reservationId" column="reservation_id" />
		<result property="waitingId" column="waiting_id" />
		<result property="rating" column="rating" />
		<result property="content" column="content" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
		<result property="avgRating" column="avgRating" />
		<result property="countRating" column="countRating" />
		<result property="countScoreRating" column="countScoreRating" />
		<result property="taste" column="taste" />
		<result property="mood" column="mood" />
		<result property="service" column="service" />
		<result property="clean" column="clean" />
	</resultMap>
	
	<resultMap id="storeInfo" type="StoreVO">
		<result property="storeId" column="store_id"/>
		<result property="ownerId" column="owner_id"/>
		<result property="storeName" column="store_Name"/>
		<result property="storeType" column="store_type" />
		<result property="zipcode" column="zipcode" />
		<result property="address" column="address"/>
		<result property="detailAddress" column="detail_address"/>
		<result property="extraAddress" column="extra_address"/>
		<result property="operationType" column="operation_type" />
		<result property="localNumber" column="local_number" />
		<result property="number1" column="number1" />
		<result property="number2" column="number2" />
		<result property="description" column="description" />
		<result property="closed" column="closed" />
		<result property="operatingTime" column="operating_time" />
		<result property="breakTime" column="break_time" />
		<result property="lastOrder" column="last_order" />
		<result property="amenities" column="amenities" />
		<result property="fileName" column="file_name" />
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
		<result property="avgRating" column="avgRating"/>
		<result property="countRating" column="countRating"/>
	</resultMap>
	
	<resultMap id="imagelist" type="ImageFileVO">
		<result property="imageId" column="image_id"/>
		<result property="storeId" column="store_id"/>
		<result property="reviewId" column="review_id"/>
		<result property="fileName" column="file_name"/>
		<result property="fileType" column="file_type"/>
		<result property="displayNo" column="display_no"/>
		<result property="createdAt" column="created_at"/>
		<result property="regId" column="reg_id"/>
	</resultMap>
	
	<select id="selectReservationById" parameterType="long" resultMap="reservationInfo">
	    <![CDATA[
	        select * from reservations where reservation_id=#{reservationId}
	    ]]>
	</select>
	
	<select id="selectWaitingById" parameterType="long" resultMap="waitingInfo">
	    <![CDATA[
	        select * from waitings where waiting_id=#{waitingId}
	    ]]>
	</select>
	
	<select id="selectStore" parameterType="long" resultMap="storeInfo">
		<![CDATA[
			SELECT store_id, store_name, file_name 
			FROM stores
			WHERE store_id=#{storeId}
		]]>
	</select>
	
	<insert id="insertReservationReview" parameterType="ReviewVO" >	    
	    <![CDATA[
	    INSERT INTO reviews (
	    	review_id,
	        member_id,
	        store_id,
	        reservation_id,
	        rating,
	        content,
	        taste,
	        mood,
	        service,
	        clean,
	        created_at
	    ) VALUES (
	    	null,
	        #{memberId},
	        #{storeId},
	        #{reservationId},
	        #{rating},
	        #{content},
	        #{taste},
	        #{mood},
	        #{service},
	        #{clean},
	        NOW()
	    )
	    ]]>
	    <selectKey keyProperty="reviewId" resultType="int" order="AFTER">
	        SELECT LAST_INSERT_ID()
	    </selectKey>
	</insert>
	
	<insert id="insertWaitingReview" parameterType="ReviewVO" useGeneratedKeys="true" keyProperty="reviewId">
	    INSERT INTO reviews (
	        member_id,
	        store_id,
	        waiting_id,
	        rating,
	        content,
	        taste,
	        mood,
	        service,
	        clean,
	        created_at
	    ) VALUES (
	        #{memberId},
	        #{storeId},
	        #{waitingId},
	        #{rating},
	        #{content},
	        #{taste},
	        #{mood},
	        #{service},
	        #{clean},
	        NOW()
	    )
	</insert>

	
	<insert id="insertReviewImageFiles" parameterType="list">
	    insert into image_file (file_name, display_no, reg_id, store_id, review_id, created_at)
	    values
	    <foreach collection="list" item="item" separator=",">
	        (
	            #{item.fileName},
	            #{item.displayNo},
	            #{item.regId},
	            #{item.storeId},
	            #{item.reviewId},
	            now()
	        )
	    </foreach>
	</insert>

</mapper>