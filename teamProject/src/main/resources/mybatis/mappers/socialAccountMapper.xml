<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.teamProject.dao.SocialAccountDAO">

    <resultMap id="socialAccountResultMap" type="com.spring.teamProject.vo.SocialAccountVO">
        <id property="socialAccountId" column="social_account_id"/>
        <result property="memberId" column="member_id"/>
        <result property="provider" column="provider"/>
        <result property="socialId" column="social_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByProviderAndSocialId" resultMap="socialAccountResultMap">
        SELECT * FROM social_accounts 
        WHERE provider = #{provider} AND social_id = #{socialId}
    </select>

    <select id="findByMemberId" resultMap="socialAccountResultMap">
        SELECT * FROM social_accounts 
        WHERE member_id = #{memberId}
    </select>

    <insert id="insertSocialAccount" parameterType="com.spring.teamProject.vo.SocialAccountVO">
        INSERT INTO social_accounts (member_id, provider, social_id)
        VALUES (#{memberId}, #{provider}, #{socialId})
    </insert>

</mapper>
