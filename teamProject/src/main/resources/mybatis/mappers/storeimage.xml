<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="mapper.storeimage">
	<resultMap id="storeimagelist" type="StoreImageVO">
		<result property="imageId" column="imageId"/>
		<result property="storeId" column="storeId"/>
		<result property="imageUrl" column="imageUrl"/>
		<result property="imageType" column="imageType"/>
		<result property="displayNo" column="displayNo"/>
		<result property="createdAt" column="createdAt"/>
	</resultMap>
	
	<select id="SelectStoreImageRegion" parameterType="String" resultType="long">
		<![CDATA[ 
			select image_id from store_images where image_type=true AND store_id = (select store_id from stores where regoin = #{region})
		]]>
	</select>
	
</mapper>