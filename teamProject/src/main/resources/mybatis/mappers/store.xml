<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="mapper.store">
	<resultMap id="storelist" type="StoreVO">
		<result property="storeId" column="storeId"/>
		<result property="ownerId" column="ownerId"/>
		<result property="storeName" column="storeName"/>
		<result property="address" column="address"/>
		<result property="region" column="region"/>
		<result property="createdAt" column="createdAt"/>
		<result property="updatedAt" column="updatedAt"/>
		<result property="avgRating" column="avgRating"/>
		<result property="countRating" column="countRating"/>
	</resultMap>
	
	<resultMap id="storeinfo" type="StoreVO">
		<result property="storeId" column="storeId" />
		<result property="storeType" column="storeType" />
		<result property="operationType" column="operationType" />
		<result property="storePhoneNumber" column="storePhoneNumber" />
		<result property="storeHours" column="storeHours" />
		<result property="breakTime" column="breakTime" />
		<result property="dayOff" column="dayOff" />
		<result property="description" column="description" />
		<result property="amenities" column="amenities" />
		<result property="mainImage" column="mainImage" />
	</resultMap>
	
	<resultMap id="imagelist" type="ImageFileVO">
		<result property="imageId" column="imageId"/>
		<result property="storeId" column="storeId"/>
		<result property="reviewId" column="reviewId"/>
		<result property="fileName" column="fileName"/>
		<result property="fileType" column="fileType"/>
		<result property="displayNo" column="displayNo"/>
		<result property="createdAt" column="createdAt"/>
		<result property="regId" column="regId"/>
	</resultMap>
	
	<select id="selectStoreName" parameterType="long" resultType="String">
		<![CDATA[ 
			select store_name from stores where store_id = #{store_id}
		]]>
	</select>
	
	<select id="selectStoreInfo" resultMap="storelist" parameterType="String">
		<![CDATA[
			select * from stores where store_id = #{store_id}
		]]>
	</select>
	
	<select id="SelectStoreRegion" parameterType="String" resultMap="storelist">
		<![CDATA[
			select i.* from store_info i inner join stores s on i.store_id=s.store_id where s.region=#{region}
		]]>
	</select>
	
	<select id="selectStoreImageList" parameterType="String" resultMap="imagelist">
		<![CDATA[ 
			select store_name from stores where region=#{region}
		]]>
	</select>
	
	<insert id="insertStoreInfo" parameterType="map" >
			insert into stores (store_id, store_type, operation_type, store_phone_number, break_time, day_off, description, amenities, created_at, update_at, main_image, start_hour, start_min, end_hour, end_min, open_day) values
			<foreach collection="storelist" item="store" separator=",">
				(
					#{store.store_id},
					#{store.store_type},
					#{store.operation_type},
					#{store.store_phone_number},
					#{store.break_time},
					#{store.day_off},
					#{store.description},
					#{store.amenities},
					#{store.main_image},
					now(),
					now(),
					#{store.start_hour},
					#{store.start_min},
					#{store.end_hour},
					#{store.end_min},
					#{store.open_day}
					
				)
			</foreach> 
			<selectKey>
				select LAST_INSERT_ID()
			</selectKey>
	</insert>
	
</mapper>