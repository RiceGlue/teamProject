<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="mapper.store">
	<resultMap id="storelist" type="StoreVO">
		<result property="store_id" column="store_id"/>
		<result property="owner_id" column="owner_id"/>
		<result property="store_name" column="store_name"/>
		<result property="address" column="address"/>
		<result property="store_phone_number" column="store_phone_number"/>
		<result property="description" column="description"/>
		<result property="operation_type" column="operation_type"/>
		<result property="created_at" column="created_at"/>
		<result property="updated_at" column="updated_at"/>
	</resultMap>
	
	<select id="SelectStoreInfo">
		<![CDATA[
			select * from stores where store_id = #{store_id}
		]]>
	</select>
	
	<select id="SelectStoreRegion" parameterType="String" resultMap="storelist">
		<![CDATA[
			select * from stores where address like #{region}
		]]>
	</select>
	
	<select id="SelectKeywordStore" >
		<![CDATA[
			select * from stores where
		]]>
	</select>
</mapper>